datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model Contact {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  name        String?
  role        String   @default("COLLABORATOR")
  tasks       Task[]   @relation("AssignedTasks")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id           String      @id @default(cuid())
  title        String
  description  String?
  priority     Priority    @default(MEDIUM)
  status       TaskStatus  @default(TODO)
  progress     Int         @default(0)
  dueDate      DateTime?
  orderIndex   Int         @default(0)
  
  // خيارات التذكير المتقدمة
  reminderType     String  @default("NONE")     // NONE, EXACT, BEFORE, EVERY_X_HOURS
  reminderOffset   Int     @default(0)          // عدد الدقائق أو عدد الساعات
  repeatDaily      Boolean @default(false)      // هل يتكرر يومياً؟
  lastReminderSent DateTime?                    // تاريخ آخر تذكير أُرسل لتفادي التكرار

  assigneeId   String?
  assignee     Contact?    @relation("AssignedTasks", fields: [assigneeId], references: [id])
  activities   ActivityLog[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  source     String   @default("SYSTEM")
  rawMessage String?
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model WhatsAppSession {
  id        String   @id
  data      String   @db.Text
  updatedAt DateTime @updatedAt
}
