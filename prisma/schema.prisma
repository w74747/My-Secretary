datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model Contact {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  name        String?
  role        String   @default("COLLABORATOR")
  tasks       Task[]   @relation("AssignedTasks")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id           String      @id @default(cuid())
  title        String
  description  String?
  priority     Priority    @default(MEDIUM)
  status       TaskStatus  @default(TODO)
  progress     Int         @default(0)
  dueDate      DateTime?
  orderIndex   Int         @default(0)
  
  // خيارات التذكير المتقدمة
  reminderType     String  @default("NONE")     // NONE, EXACT, BEFORE, EVERY_X_HOURS
  reminderOffset   Int     @default(0)          // عدد الدقائق أو عدد الساعات
  repeatDaily      Boolean @default(false)      // هل يتكرر يومياً؟
  lastReminderSent DateTime?                    // تاريخ آخر تذكير أُرسل لتفادي التكرار

  assigneeId   String?
  assignee     Contact?    @relation("AssignedTasks", fields: [assigneeId], references: [id])
  activities   ActivityLog[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  source     String   @default("SYSTEM")
  rawMessage String?
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model WhatsAppSession {
  id        String   @id
  data      String   @db.Text
  updatedAt DateTime @updatedAt
}
model Habit {
  id          String     @id @default(uuid())
  title       String
  category    String     // SPIRITUAL (عبادات), FITNESS (رياضة), HEALTH (صحة), LEARNING (تعلم)
  points      Int        @default(10) // النقاط المكتسبة عند إنجازها يومياً
  targetCount Int        @default(1)  // مثلاً: 5 صلوات، أو 1 لورد القرآن
  unit        String?    // مثل: "ركعة", "صفحة", "خطوة"
  createdAt   DateTime   @default(now())
  logs        HabitLog[]
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @default(now()) // تاريخ اليوم المسجل
  completed Boolean  @default(true)
  count     Int      @default(1)
  
  @@unique([habitId, date])
}

model Reward {
  id          String   @id @default(uuid())
  title       String   // مثل: قطعة شوكولاتة داكنة، آيسكريم، ساعة لعب
  costPoints  Int      // تكلفة فتح المكافأة بالنقاط
  icon        String?  // أيقونة المكافأة
  isClaimed   Boolean  @default(false)
  claimedAt   DateTime?
  createdAt   DateTime @default(now())
}
model Agent {
  id          String     @id @default(uuid())
  name        String     // مثل: المدير المالي، وكيل أبحاث الويب، مستشار العملات الرقمية
  role        String     // FINANCIAL, RESEARCHER, PLANNER, CRYPTO
  description String?    // نبذة عن مهام الوكيل
  systemPrompt String   @db.Text // التوجيهات الدقيقة للوكيل
  apiKey      String?    // مفتاح API المخصص للوكيل (اختياري)
  provider    String     @default("TOGETHER") // TOGETHER, GROQ, OPENAI
  isActive    Boolean    @default(true)
  canSearchWeb Boolean   @default(false) // صلاحية البحث في الويب
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  logs        AgentLog[]
}

model AgentLog {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  query     String   @db.Text // السؤال أو المهمة المطلوبة من الوكيل
  response  String   @db.Text // التقرير أو الإجابة التي قدمها الوكيل
  createdAt DateTime @default(now())
}
