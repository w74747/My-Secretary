datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model Contact {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  name        String?
  role        String   @default("COLLABORATOR")
  tasks       Task[]   @relation("AssignedTasks")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id               String        @id @default(cuid())
  title            String
  description      String?
  priority         Priority      @default(MEDIUM)
  status           TaskStatus    @default(TODO)
  progress         Int           @default(0)
  dueDate          DateTime?
  orderIndex       Int           @default(0)
  
  // خيارات التذكير المتقدمة
  reminderType     String        @default("NONE")     // NONE, EXACT, BEFORE, EVERY_X_HOURS
  reminderOffset   Int           @default(0)          // عدد الدقائق أو عدد الساعات
  repeatDaily      Boolean       @default(false)
  lastReminderSent DateTime?
  googleEventId    String?                            // معرف الحدث في تقويم جوجل للمزامنة والتعديل والحذف

  assigneeId       String?
  assignee         Contact?      @relation("AssignedTasks", fields: [assigneeId], references: [id])
  activities       ActivityLog[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  source      String   @default("SYSTEM")
  rawMessage  String?
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model WhatsAppSession {
  id        String   @id
  data      String   @db.Text
  updatedAt DateTime @updatedAt
}

model Habit {
  id          String     @id @default(uuid())
  title       String
  category    String     // SPIRITUAL, FITNESS, HEALTH, LEARNING
  points      Int        @default(10)
  targetCount Int        @default(1)
  unit        String?
  createdAt   DateTime   @default(now())
  logs        HabitLog[]
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  completed Boolean  @default(true)
  count     Int      @default(1)
  
  @@unique([habitId, date])
}

model Reward {
  id          String    @id @default(uuid())
  title       String
  costPoints  Int
  icon        String?
  isClaimed   Boolean   @default(false)
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Agent {
  id           String     @id @default(uuid())
  name         String
  role         String     // FINANCIAL, RESEARCHER, PLANNER, CRYPTO
  description  String?
  systemPrompt String     @db.Text
  apiKey       String?
  provider     String     @default("TOGETHER")
  isActive     Boolean    @default(true)
  canSearchWeb Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  logs         AgentLog[]
}

model AgentLog {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  query     String   @db.Text
  response  String   @db.Text
  createdAt DateTime @default(now())
}

model GoogleAuth {
  id           String   @id @default("default_user")
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiryDate   BigInt?
  updatedAt    DateTime @updatedAt
}
