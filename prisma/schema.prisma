datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// Enums لضمان سلامة البيانات ومنع الأخطاء الإملائية
// ==========================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReminderType {
  NONE
  EXACT
  BEFORE
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum AgentRole {
  FINANCIAL
  CRYPTO
  RESEARCHER
}

enum AgentProvider {
  TOGETHER
  OPENAI
  ANTHROPIC
}

// ==========================================
// النماذج الرئيسية
// ==========================================

model Task {
  id              String       @id @default(uuid())
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        Priority     @default(MEDIUM)
  dueDate         DateTime?
  reminderType    ReminderType @default(NONE)
  reminderOffset  Int          @default(0) // بالدقائق قبل الموعد
  googleEventId   String?
  sourceMessageId String?      @unique     // لمنع تكرار استخراج نفس المهمة من الإيميل (Idempotency)
  assigneeId      String?
  assignee        Agent?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())

  @@index([status, dueDate]) // فهرس لتحسين أداء مجدول التنبيهات
}

model Habit {
  id          String     @id @default(uuid())
  title       String
  category    String     @default("SPIRITUAL")
  points      Int        @default(10)
  targetCount Int        @default(1)
  unit        String?
  frequency   Frequency  @default(DAILY)
  customDays  Int?       @default(1)
  targetTime  String?    // مثال: "06:00"
  createdAt   DateTime   @default(now())
  logs        HabitLog[]
}

model HabitLog {
  id            String   @id @default(uuid())
  habitId       String
  habit         Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date // تخزين التاريخ المحلي فقط لتجنب مشاكل التوقيت العالمي (UTC)
  completed     Boolean  @default(true)
  pointsAwarded Int      // حفظ النقاط وقت الإنجاز لضمان عدم تغييرها بأثر رجعي عند تعديل العادة
  createdAt     DateTime @default(now())

  @@unique([habitId, date]) // قيد فريد يمنع تسجيل نفس العادة مرتين في نفس اليوم
}

// دفتر قيود النقاط (Ledger) للشفافية المطلقة وتتبع الرصيد
model PointsTransaction {
  id          String   @id @default(uuid())
  amount      Int      // موجب عند الإنجاز، سالب عند استبدال المكافأة
  reason      String   // مثال: "HABIT_COMPLETION" أو "REWARD_CLAIM"
  referenceId String?  // معرف سجل الإنجاز أو استبدال المكافأة
  createdAt   DateTime @default(now())
}

model Reward {
  id        String        @id @default(uuid())
  title     String
  costPoints Int
  icon      String?
  claims    RewardClaim[]
  createdAt DateTime      @default(now())
}

// فصل تعريف المكافأة عن سجل طلبها لدعم المكافآت القابلة للتكرار
model RewardClaim {
  id        String   @id @default(uuid())
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  claimedAt DateTime @default(now())
}

model Agent {
  id           String        @id @default(uuid())
  name         String
  role         AgentRole
  description  String?
  systemPrompt String?       @db.Text
  apiKey       String?       // يُنصح بتشفيره في طبقة التطبيق (Application Layer Encryption)
  provider     AgentProvider @default(TOGETHER)
  canSearchWeb Boolean       @default(false)
  isActive     Boolean       @default(true)
  tasks        Task[]
}

model GoogleAuth {
  id           String   @id @default("default_user")
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  expiryDate   BigInt?
}
