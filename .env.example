# المنفذ المحلي
PORT=3000

# رابط قاعدة بيانات PostgreSQL (تأخذه من لوحة تحكم Railway عند إنشاء قاعدة البيانات)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# مفتاح واجهة الذكاء الاصطناعي من OpenAI
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx"

# بيئة التشغيل
NODE_ENV="production"
