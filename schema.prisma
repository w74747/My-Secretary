datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectStatus {
  NEW
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  PAUSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id          String        @id @default(uuid())
  title       String
  description String?
  color       String?       @default("#8B5CF6")
  orderIndex  Float         @default(0.0)
  status      ProjectStatus @default(IN_PROGRESS)
  progress    Int           @default(0)
  deadline    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks       Task[]
  activities  ActivityLog[]
}

model Task {
  id          String      @id @default(uuid())
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  status      TaskStatus  @default(TODO)
  priority    Priority    @default(MEDIUM)
  progress    Int         @default(0)
  orderIndex  Float       @default(0.0)
  
  dueDate     DateTime?
  timerEnd    DateTime?
  
  assigneeId  String?
  assignee    Contact?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  subtasks    Subtask[]
  activities  ActivityLog[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Subtask {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean  @default(false)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
}

model Contact {
  id          String   @id @default(uuid())
  name        String
  phoneNumber String   @unique
  role        String?
  tasks       Task[]
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(uuid())
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  action      String
  source      String
  rawMessage  String?
  createdAt   DateTime @default(now())
}

model WhatsAppSession {
  id        String   @id
  data      String   @db.Text
  updatedAt DateTime @updatedAt
}
